erDiagram
    User {
        TEXT id PK
        TEXT display_name
        TEXT email
        TEXT role
        TEXT status
        TEXT phone
        TEXT bio
        TEXT city
        TEXT avatar_key
        TEXT cover_key
        TEXT created_at
    }
    Verification {
        TEXT id PK
        TEXT user_id FK
        TEXT status
        TEXT submitted_at
        TEXT reviewer_id FK
        TEXT reviewed_at
        TEXT expires_at
        TEXT reason
    }
    Address {
        TEXT id PK
        TEXT user_id FK
        TEXT recipient
        TEXT phone
        TEXT line
        TEXT city
        INTEGER is_default
    }
    Category {
        TEXT id PK
        TEXT name
        TEXT description
        INTEGER active
    }
    Listing {
        TEXT id PK
        TEXT seller_id FK
        TEXT kind
        TEXT title
        TEXT description
        TEXT status
        TEXT city
        REAL latitude
        REAL longitude
        TEXT tags_json
        TEXT created_at
        TEXT moderator_id FK
        TEXT moderation_reason
    }
    ListingItem {
        TEXT id PK
        TEXT listing_id FK
        TEXT category_id FK
        TEXT name
        TEXT material
        TEXT condition
        INTEGER price_vnd
        INTEGER stock
        TEXT unit
    }
    MediaAsset {
        TEXT id PK
        TEXT uploader_id FK
        TEXT storage_key
        TEXT mime_type
        TEXT visibility
        TEXT listing_id FK
        TEXT message_id FK
        TEXT content_id FK
        TEXT report_id FK
        TEXT verification_id FK
    }
    Interaction {
        TEXT id PK
        TEXT user_id FK
        TEXT type
        TEXT listing_id FK
        TEXT content_id FK
        TEXT target_user_id FK
        TEXT parent_comment_id FK
        INTEGER like_count
        TEXT body
        TEXT read_at
        TEXT created_at
    }
    Order {
        TEXT id PK
        TEXT buyer_id FK
        TEXT seller_id FK
        TEXT address_id FK
        TEXT delivery_snapshot
        TEXT status
        INTEGER subtotal_vnd
        INTEGER shipping_vnd
        INTEGER total_vnd
        TEXT created_at
        TEXT completed_at
    }
    OrderItem {
        TEXT id PK
        TEXT order_id FK
        TEXT listing_item_id FK
        TEXT title_snapshot
        INTEGER quantity
        INTEGER unit_price_vnd
    }
    Payment {
        TEXT id PK
        TEXT order_id FK
        TEXT parent_payment_id FK
        TEXT kind
        TEXT provider
        TEXT provider_ref
        TEXT idempotency_key
        INTEGER amount_vnd
        TEXT currency
        TEXT status
        TEXT created_at
        TEXT confirmed_at
    }
    Conversation {
        TEXT id PK
        TEXT member_a_id FK
        TEXT member_b_id FK
        TEXT order_id FK
        TEXT created_at
    }
    Message {
        TEXT id PK
        TEXT conversation_id FK
        TEXT sender_id FK
        TEXT body
        TEXT content_id FK
        TEXT content_kind
        TEXT sent_at
        TEXT read_at
    }
    Report {
        TEXT id PK
        TEXT reporter_id FK
        TEXT listing_id FK
        TEXT content_id FK
        TEXT target_user_id FK
        TEXT order_id FK
        TEXT reason
        TEXT status
        TEXT resolver_id FK
        TEXT resolution
        TEXT created_at
    }
    GreenLedger {
        TEXT id PK
        TEXT user_id FK
        TEXT order_id FK
        TEXT content_id FK
        INTEGER points
        TEXT reason
        TEXT dedupe_key
        TEXT created_at
    }
    ContentEntry {
        TEXT id PK
        TEXT author_id FK
        TEXT parent_id FK
        TEXT kind
        TEXT title
        TEXT body
        TEXT status
        TEXT starts_at
        TEXT ends_at
        INTEGER points_cost
        TEXT metadata_json
    }
    AuditLog {
        TEXT id PK
        TEXT actor_id FK
        TEXT action
        TEXT entity_type
        TEXT entity_id
        TEXT reason
        TEXT created_at
    }
    SystemSetting {
        TEXT id PK
        TEXT key
        TEXT value_json
        TEXT updated_by FK
        TEXT updated_at
    }
    User ||--o{ Verification : user_id
    User |o--o{ Verification : reviewer_id
    User ||--o{ Address : user_id
    User ||--o{ Listing : seller_id
    User |o--o{ Listing : moderator_id
    Listing ||--o{ ListingItem : listing_id
    Category ||--o{ ListingItem : category_id
    User ||--o{ MediaAsset : uploader_id
    Listing |o--o{ MediaAsset : listing_id
    Message |o--o{ MediaAsset : message_id
    ContentEntry |o--o{ MediaAsset : content_id
    Report |o--o{ MediaAsset : report_id
    Verification |o--o{ MediaAsset : verification_id
    User ||--o{ Interaction : user_id
    Listing |o--o{ Interaction : listing_id
    ContentEntry |o--o{ Interaction : content_id
    User |o--o{ Interaction : target_user_id
    Interaction |o--o{ Interaction : parent_comment_id
    User ||--o{ Order : buyer_id
    User ||--o{ Order : seller_id
    Address |o--o{ Order : address_id
    Order ||--o{ OrderItem : order_id
    ListingItem ||--o{ OrderItem : listing_item_id
    Order ||--o{ Payment : order_id
    Payment |o--o{ Payment : parent_payment_id
    User ||--o{ Conversation : member_a_id
    User ||--o{ Conversation : member_b_id
    Order |o--o{ Conversation : order_id
    Conversation ||--o{ Message : conversation_id
    User ||--o{ Message : sender_id
    ContentEntry |o--o{ Message : content_id
    User ||--o{ Report : reporter_id
    Listing |o--o{ Report : listing_id
    ContentEntry |o--o{ Report : content_id
    User |o--o{ Report : target_user_id
    Order |o--o{ Report : order_id
    User |o--o{ Report : resolver_id
    User ||--o{ GreenLedger : user_id
    Order |o--o{ GreenLedger : order_id
    ContentEntry |o--o{ GreenLedger : content_id
    User ||--o{ ContentEntry : author_id
    ContentEntry |o--o{ ContentEntry : parent_id
    User ||--o{ AuditLog : actor_id
    User ||--o{ SystemSetting : updated_by
