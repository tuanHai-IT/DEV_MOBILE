{
  "auth": { "providers": { "emailPassword": true } },
  "functions": [
    {
      "source": "backend",
      "codebase": "ecoshare",
      "runtime": "nodejs22",
      "predeploy": ["npm --prefix backend run build"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": { "rules": "storage.rules" },
  "hosting": {
    "public": "admin-web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "tests/**", "scripts/**", "README.md", "firebase-config.local.js", "firebase-config.example.js", "setup-password*"],
    "predeploy": ["node admin-web/scripts/configure-firebase.mjs"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      },
      { "source": "/firebase-config.production.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
    ],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "asia-southeast1" } }
    ]
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8180 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "hosting": { "host": "127.0.0.1", "port": 5174 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4000 },
    "singleProjectMode": true
  }
}
