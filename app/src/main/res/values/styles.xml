<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Eco" />
    <style name="Eco.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/eco_muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
    <style name="Eco.Title" parent="Eco.Body">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/eco_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">18dp</item>
    </style>
    <style name="Eco.Eyebrow" parent="Eco.Body">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/eco_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
    <style name="Eco.CardTitle" parent="Eco.Body">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/eco_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="Eco.Badge" parent="Eco.Body">
        <item name="android:background">@drawable/bg_mint</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/eco_green</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="Eco.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>
    <style name="Eco.Hero" parent="Eco.Card">
        <item name="android:background">@drawable/bg_hero</item>
        <item name="android:padding">22dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="Eco.HeroTitle" parent="Eco.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">28sp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Eco.HeroLabel" parent="Eco.Eyebrow">
        <item name="android:textColor">@color/eco_lime</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="Eco.HeroBody" parent="Eco.Body">
        <item name="android:textColor">#E2F5EB</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:layout_marginBottom">0dp</item>
    </style>
    <style name="Eco.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="elevation">1.5dp</item>
    </style>
    <style name="Eco.Secondary" parent="Eco.Button">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/eco_ink</item>
        <item name="strokeColor">@color/eco_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Eco.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/eco_green</item>
    </style>
    <style name="Eco.PriceTag">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/eco_green</item>
    </style>
</resources>
