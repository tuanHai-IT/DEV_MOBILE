<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/community_mint">
    <LinearLayout android:id="@id/community_header" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp" android:background="#FFFFFF">
        <TextView android:id="@id/community_back" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="&#x2039;" android:textSize="30sp" android:textColor="@color/community_green" android:contentDescription="@string/community_back_label" android:background="@drawable/community_pill" android:clickable="true" android:focusable="true" />
        <LinearLayout android:id="@+id/chat_header_identity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:clickable="true" android:focusable="true">
            <LinearLayout android:id="@+id/chat_header_avatar" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:orientation="horizontal" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp">
                <TextView android:id="@id/community_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trò chuyện" android:textColor="@color/community_ink" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/chat_header_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xem hồ sơ" android:textColor="@color/community_green" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@id/community_action" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:gravity="center" android:paddingHorizontal="8dp" android:textColor="@color/community_green" android:textStyle="bold" android:visibility="gone" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <ScrollView android:id="@id/community_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@id/community_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="24dp" />
    </ScrollView>
    <HorizontalScrollView android:id="@+id/chat_quick_replies" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:fillViewport="false" android:background="@color/community_mint" android:visibility="gone">
        <LinearLayout android:id="@+id/chat_quick_reply_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="6dp" />
    </HorizontalScrollView>
    <LinearLayout android:id="@id/community_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="#FFFFFF" android:visibility="gone" />
</LinearLayout>
