<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_eco_fullscreen_gradient">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="250dp">
      <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/img_cover_plants" android:scaleType="centerCrop" android:importantForAccessibility="no" />
      <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#990B3425" android:importantForAccessibility="no" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingHorizontal="24dp" android:paddingTop="36dp" android:paddingBottom="28dp">
      <LinearLayout android:layout_width="56dp" android:layout_height="56dp" android:gravity="center" android:background="@drawable/bg_badge_verified" android:backgroundTint="#33FFFFFF" android:layout_marginBottom="16dp">
        <TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:translationY="-3dp" android:text="♻︎" android:textColor="@color/eco_lime" android:textSize="31sp" android:contentDescription="@string/login_logo_desc" />
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/login_brand_title" android:textColor="@color/white" android:textSize="36sp" android:textStyle="bold" android:fontFamily="serif" android:layout_marginBottom="6dp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/login_brand_sub" android:textColor="#E0F2E9" android:textSize="13.5sp" android:gravity="center" android:layout_marginBottom="24dp" />
      </LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:backgroundTint="@color/white" android:paddingHorizontal="24dp" android:paddingTop="28dp" android:paddingBottom="36dp">
      <TextView android:id="@+id/login_heading" style="@style/Eco.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/login_welcome_title" android:textSize="22sp" android:layout_marginBottom="4dp" />
      <TextView style="@style/Eco.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/login_welcome_sub" android:textSize="13sp" android:textColor="@color/eco_muted" android:layout_marginBottom="20dp" />
      
      <TextView style="@style/Eco.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/login_email_lbl" android:textSize="11sp" android:textColor="@color/eco_muted" android:layout_marginBottom="6dp" />
      <com.google.android.material.textfield.TextInputLayout style="@style/Eco.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/login_email_hint" android:layout_marginBottom="12dp">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/login_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" />
      </com.google.android.material.textfield.TextInputLayout>
      <TextView style="@style/Eco.Eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/login_pwd_lbl" android:textSize="11sp" android:textColor="@color/eco_muted" android:layout_marginBottom="6dp" />
      <com.google.android.material.textfield.TextInputLayout style="@style/Eco.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/login_pwd_hint" app:passwordToggleEnabled="true" android:layout_marginBottom="6dp">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/login_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" />
      </com.google.android.material.textfield.TextInputLayout>
      <TextView android:id="@+id/go_forgot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/login_forgot_link" android:textColor="@color/eco_ink" android:textSize="12.5sp" android:textStyle="bold" android:paddingVertical="4dp" android:layout_marginBottom="16dp" android:tag="screen:forgot_password" android:focusable="true" android:minHeight="48dp" android:gravity="center_vertical" />
      <com.google.android.material.button.MaterialButton android:id="@+id/login_submit_btn" style="@style/Eco.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_demo_submit" android:textSize="15sp" android:tag="login:verified" android:layout_marginBottom="8dp" android:focusable="true" android:minHeight="48dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_google" style="@style/Eco.Secondary" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="@string/login_google" android:textColor="#334155" android:textSize="13sp" app:icon="@drawable/ic_google" app:iconSize="18dp" app:iconTint="@null" app:iconGravity="textStart" app:strokeColor="#CBD5E1" app:strokeWidth="1dp" android:tag="social:google" android:focusable="true" android:minHeight="48dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_apple" style="@style/Eco.Secondary" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="@string/login_apple" android:textColor="#334155" android:textSize="13sp" app:icon="@drawable/ic_apple" app:iconSize="18dp" app:iconTint="@null" app:iconGravity="textStart" app:strokeColor="#CBD5E1" app:strokeWidth="1dp" android:tag="social:apple" android:focusable="true" android:minHeight="48dp" />
      </LinearLayout>
      <TextView android:id="@+id/go_register" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:padding="8dp" android:layout_marginBottom="24dp" android:text="@string/login_footer_register" android:textColor="@color/eco_ink" android:textSize="13sp" android:tag="screen:register" android:focusable="true" android:minHeight="48dp" android:gravity="center_vertical" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
