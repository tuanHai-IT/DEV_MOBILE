<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/eco_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingVertical="18dp">
    <TextView style="@style/Eco.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/my_impact_subtitle" />
    <TextView style="@style/Eco.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/my_impact_heading" android:id="@+id/my_impact_heading" />
    <LinearLayout style="@style/Eco.Hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp">
      <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_award" android:layout_marginBottom="8dp" android:importantForAccessibility="no" />
      <TextView style="@style/Eco.HeroLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/impact_total_label" android:layout_gravity="center" />
      <TextView style="@style/Eco.HeroTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/impact_points" android:text="@string/init_points" android:textSize="32sp" android:layout_gravity="center" android:layout_marginBottom="6dp" />
      <TextView style="@style/Eco.HeroBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/impact_note" android:gravity="center" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton style="@style/Eco.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/impact_badges" android:text="@string/impact_badges" android:tag="screen:badges" app:icon="@drawable/ic_award" app:iconGravity="textStart" app:iconSize="18dp" app:iconPadding="8dp" android:focusable="true" android:minHeight="48dp" />
    <com.google.android.material.button.MaterialButton style="@style/Eco.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/impact_leaderboard" android:text="@string/impact_leaderboard" android:tag="screen:leaderboard" app:icon="@drawable/ic_star" app:iconGravity="textStart" app:iconSize="18dp" app:iconPadding="8dp" android:focusable="true" android:minHeight="48dp" />
  </LinearLayout>
</ScrollView>