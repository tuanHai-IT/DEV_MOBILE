            <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:orientation="horizontal" android:gravity="center_vertical" android:tag="screen:addresses" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
