            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/Eco.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:text="VỀ ECOSHARE" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:background="@drawable/community_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal" android:gravity="center_vertical" android:tag="screen:my_impact" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
