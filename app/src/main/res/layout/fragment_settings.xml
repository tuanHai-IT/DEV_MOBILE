                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email &amp; Số điện thoại" android:textColor="@color/eco_ink" android:textSize="14sp" android:textStyle="bold" />
