<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071009">

    <ScrollView
        android:id="@id/community_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:id="@id/community_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#071009" />
    </ScrollView>

    <LinearLayout
        android:id="@id/community_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <TextView
            android:id="@id/community_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="&#x2039;"
            android:textSize="27sp"
            android:textColor="#E7FAEC"
            android:contentDescription="@string/community_back_label"
            android:background="@drawable/bg_scan_side"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@id/community_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@id/community_action"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:textColor="#C4EAD0"
            android:textSize="12sp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@id/community_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp"
        android:background="#050805"
        android:visibility="gone" />
</FrameLayout>
