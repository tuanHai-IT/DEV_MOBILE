<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@color/eco_background">
  <LinearLayout android:id="@+id/bottom_nav_container" android:layout_width="80dp" android:layout_height="match_parent" android:orientation="vertical" android:elevation="12dp" android:background="@color/white">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false" android:scrollbars="none">
      <LinearLayout android:id="@+id/bottom_navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:background="@color/white"  android:baselineAligned="false" android:minHeight="68dp">
        <LinearLayout android:id="@+id/nav_home" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="vertical" android:gravity="center" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="?attr/selectableItemBackgroundBorderless" android:tag="screen:home" android:focusable="true" android:minHeight="48dp">
          <ImageView android:id="@+id/nav_home_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_home" app:tint="@color/eco_green" android:contentDescription="Trang chủ" android:importantForAccessibility="no" />
          <TextView android:id="@+id/nav_home_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trang chủ" android:textSize="10sp" android:textColor="@color/eco_green" android:textStyle="bold" android:layout_marginTop="2dp" />
          <View android:id="@+id/nav_home_dot" android:layout_width="4dp" android:layout_height="4dp" android:background="@drawable/bg_nav_dot" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_explore" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="vertical" android:gravity="center" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="?attr/selectableItemBackgroundBorderless" android:tag="screen:explore" android:focusable="true" android:minHeight="48dp">
          <ImageView android:id="@+id/nav_explore_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_explore" app:tint="#94A3B8" android:contentDescription="Khám phá" android:importantForAccessibility="no" />
          <TextView android:id="@+id/nav_explore_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Khám phá" android:textSize="10sp" android:textColor="#94A3B8" android:layout_marginTop="2dp" />
          <View android:id="@+id/nav_explore_dot" android:layout_width="4dp" android:layout_height="4dp" android:background="@drawable/bg_nav_dot" android:visibility="invisible" android:layout_marginTop="2dp" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="56dp"  android:gravity="center">
          <LinearLayout android:id="@+id/nav_create" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:gravity="center" android:background="@drawable/bg_nav_create" android:elevation="4dp" android:tag="screen:create_post" android:contentDescription="@string/new_post_access" android:focusable="true" android:minHeight="48dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_plus" app:tint="@color/white" android:contentDescription="Tạo bài viết" />
          </LinearLayout>
        </FrameLayout>
        <LinearLayout android:id="@+id/nav_messages" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="vertical" android:gravity="center" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="?attr/selectableItemBackgroundBorderless" android:tag="screen:messages" android:focusable="true" android:minHeight="48dp">
          <ImageView android:id="@+id/nav_messages_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_messages" app:tint="#94A3B8" android:contentDescription="Tin nhắn" android:importantForAccessibility="no" />
          <TextView android:id="@+id/nav_messages_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tin nhắn" android:textSize="10sp" android:textColor="#94A3B8" android:layout_marginTop="2dp" />
          <View android:id="@+id/nav_messages_dot" android:layout_width="4dp" android:layout_height="4dp" android:background="@drawable/bg_nav_dot" android:visibility="invisible" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_profile" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="vertical" android:gravity="center" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="?attr/selectableItemBackgroundBorderless" android:tag="screen:profile" android:focusable="true" android:minHeight="48dp">
          <ImageView android:id="@+id/nav_profile_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_profile" app:tint="#94A3B8" android:contentDescription="Hồ sơ" android:importantForAccessibility="no" />
          <TextView android:id="@+id/nav_profile_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hồ sơ" android:textSize="10sp" android:textColor="#94A3B8" android:layout_marginTop="2dp" />
          <View android:id="@+id/nav_profile_dot" android:layout_width="4dp" android:layout_height="4dp" android:background="@drawable/bg_nav_dot" android:visibility="invisible" android:layout_marginTop="2dp" />
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
    <LinearLayout android:id="@+id/top_app_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@color/white" android:elevation="2dp" android:minHeight="64dp" android:paddingTop="4dp" android:paddingBottom="4dp">
      <com.google.android.material.button.MaterialButton android:id="@+id/back_button" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="8dp" android:contentDescription="@string/back" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" app:cornerRadius="19dp" app:backgroundTint="@color/eco_mint" app:icon="@drawable/ic_arrow_back" app:iconTint="@color/eco_ink" app:iconSize="20dp" app:iconGravity="textStart" android:visibility="gone" android:focusable="true" />
      <TextView android:id="@+id/top_logo" android:layout_width="30dp" android:layout_height="32dp" android:layout_marginEnd="6dp" android:gravity="center" android:text="♻︎" android:textColor="@color/eco_green" android:textSize="25sp" android:contentDescription="@string/app_name" />
      <TextView android:id="@+id/top_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" android:textColor="@color/eco_ink" android:textSize="20sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
      <TextView android:id="@+id/guest_login_action" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Đăng nhập" android:textColor="@color/eco_green" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" android:focusable="true" android:contentDescription="Đăng nhập để sử dụng đầy đủ ứng dụng" />
      <LinearLayout android:id="@+id/top_actions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/top_btn_friends" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" app:cornerRadius="19dp" app:backgroundTint="#EAF7EE" app:icon="@drawable/ic_friends" app:iconTint="@color/eco_green" app:iconSize="18dp" app:iconGravity="textStart" android:tag="screen:friends" android:contentDescription="@string/friends_access" android:focusable="true" android:minHeight="48dp" />
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp">
          <com.google.android.material.button.MaterialButton android:id="@+id/top_btn_notifications" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp" app:cornerRadius="19dp" app:backgroundTint="#EAF7EE" app:icon="@drawable/ic_bell" app:iconTint="@color/eco_green" app:iconSize="18dp" app:iconGravity="textStart" android:tag="screen:notifications" android:contentDescription="@string/notification_access" android:focusable="true" android:minHeight="48dp" />
          <TextView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="top|end" android:background="@drawable/bg_badge_rejected" android:gravity="center" android:text="1" android:textColor="@color/white" android:textSize="9.5sp" android:textStyle="bold" android:id="@+id/notification_badge" android:importantForAccessibility="no" />
        </FrameLayout>
          <FrameLayout android:id="@+id/top_btn_scanner" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_nav_create" android:foreground="?attr/selectableItemBackground" android:tag="screen:scanner" android:contentDescription="@string/scanner_access" android:clickable="true" android:focusable="true" android:minHeight="48dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_qr_scan" app:tint="@color/white" android:importantForAccessibility="no" />
          </FrameLayout>
      </LinearLayout>
    </LinearLayout>
    <androidx.fragment.app.FragmentContainerView android:id="@+id/screen_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
  </LinearLayout>
</LinearLayout>
